#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_STM32H747I_DISCO

config STM32H747I_DISCO_LCD
	bool "MB1166 DSI display"
	default n
	depends on VIDEO_FB && STM32_FMC
	select STM32_DSIHOST
	select STM32_LTDC
	select MIPI_DSI
	---help---
		Framebuffer driver for the 4" 800x480 display of the MB1166
		display board, connected over two DSI lanes in video mode.  The
		OTM8009A and NT35510 controllers are detected at runtime.  The
		framebuffer is in the SDRAM, at CONFIG_STM32_LTDC_FB_BASE.

endif # ARCH_BOARD_STM32H747I_DISCO
